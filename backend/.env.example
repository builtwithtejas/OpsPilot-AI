# backend/.env.example
# Copy this to .env and fill in your values.
# NEVER commit .env to git — it's already in .gitignore.

# ── App ─────────────────────────────────────────────────────────
APP_NAME=OpsPilot AI
APP_VERSION=1.0.0
DEBUG=false

# ── Auth ────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-strong-random-api-key-here

# ── Google Gemini ────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ── GitHub ───────────────────────────────────────────────────────
GITHUB_TOKEN=your-github-pat
GITHUB_REPO=youruser/yourrepo
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── GitLab ───────────────────────────────────────────────────────
GITLAB_TOKEN=your-gitlab-pat
GITLAB_BASE_URL=https://gitlab.com
GITLAB_AGENT_ID=1009889
GITLAB_MCP_URL=https://gitlab.com/api/v4/ai/agents/1009889/mcp
GITLAB_GROUP=your-gitlab-group
GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret

# ── Notifications ────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SENDGRID_API_KEY=SG.your-sendgrid-key
ALERT_EMAIL_TO=oncall@yourcompany.com
ALERT_EMAIL_FROM=alerts@opspilot.ai
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────
# Local dev: sqlite:///./opspilot.db
# Production: postgresql://user:password@host:5432/opspilot
DATABASE_URL=sqlite:///./opspilot.db

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of exact origins you want to allow.
# FIX: Use specific origins, not wildcards.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── AI Log Analysis ──────────────────────────────────────────────
# Max characters of log text sent to Gemini per analysis.
# Increase for deeper analysis; decrease to save tokens/cost.
MAX_LOG_CHARS=8000

# ── Uploads ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
